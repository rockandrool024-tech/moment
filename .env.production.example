# Copy to .env at the repo root on the VPS (docker-compose.prod.yml reads it).
# This is the ONE env file for the whole prod stack — the api container also
# gets these via `env_file: .env` in docker-compose.prod.yml.

# Point both of these at your VPS's IP before first deploy (A records):
#   DOMAIN            -> your VPS IP
#   api.DOMAIN         -> your VPS IP
DOMAIN=example.com

POSTGRES_USER=moment
POSTGRES_PASSWORD="change-me-to-a-long-random-string"
POSTGRES_DB=moment

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# Stripe Connect — https://dashboard.stripe.com/apikeys (live keys once you're ready)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key is baked into the web build at image-build time (see
# apps/web/Dockerfile) — changing it requires rebuilding the web image.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mux — https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# Twilio Verify — https://console.twilio.com/us1/develop/verify/services
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Comma-separated E.164 numbers granted /admin/* access. Empty = admin
# disabled. Add your own number here before go-live if you need the KYB
# queue / dispute resolution / force-reveal tools.
ADMIN_PHONE_NUMBERS=
