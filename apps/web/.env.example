# Copy to .env.local

# The NestJS API's base URL — browser-visible, so must be NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Stripe *publishable* key (safe to expose client-side). Leave blank and the
# funding page just shows a "payments not configured" notice instead of the
# card form.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Web Push VAPID public key (safe to expose client-side) — must match the
# API's VAPID_PUBLIC_KEY. Generate both with:
# pnpm --filter @moment/api exec ts-node -T scripts/generate-vapid-keys.ts
# Leave blank and the push opt-in on /notifications stays hidden.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
