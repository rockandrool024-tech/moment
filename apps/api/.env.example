# Copy to .env and fill in. The app boots fine with placeholder provider
# keys — Stripe/Mux/Twilio calls only fail once actually invoked.

NODE_ENV=development
PORT=3000

# docker compose up -d exposes these on localhost by default (see /docker-compose.yml)
DATABASE_URL="postgresql://moment:moment@localhost:5432/moment?schema=public"
REDIS_URL="redis://localhost:6379"

# Any long random string in development. Use a real secret manager in production.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# Stripe Connect — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mux — https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# Twilio Verify — https://console.twilio.com/us1/develop/verify/services
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Public URL of the web app (apps/web) — used for CORS and Stripe Connect
# onboarding redirect links.
APP_URL="http://localhost:3001"
CORS_ORIGIN="http://localhost:3001"

# Comma-separated E.164 phone numbers granted access to /admin/* (god-view,
# force-reveal, KYB queue, disputes, growth dashboard). No self-service admin
# role — reviewed manually, changed by redeploy. Leave empty to disable
# admin access entirely.
ADMIN_PHONE_NUMBERS=
